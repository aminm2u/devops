# Database Configuration
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?schema=public

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT & Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# App Config
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:8080

# Grafana Integration
GRAFANA_URL=
GRAFANA_FRONTEND_URL=
GRAFANA_API_KEY=
GRAFANA_DASHBOARDS=

# SMTP / Email Service
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=

# Frontend Config
VITE_API_URL=http://localhost:8080/api
VITE_SOCKET_URL=http://localhost:8080
