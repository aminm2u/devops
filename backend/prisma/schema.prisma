generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== REFERENCE TABLES ====================

model Department {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  managerId Int?     @map("manager_id")
  employees User[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("departments")
}

model Position {
  id         Int    @id @default(autoincrement())
  name       String
  gradeLevel Int?   @map("grade_level")
  employees  User[]

  @@map("positions")
}

model EmploymentType {
  id        Int    @id @default(autoincrement())
  name      String
  employees User[]

  @@map("employment_types")
}

model ProjectType {
  id       Int       @id @default(autoincrement())
  name     String
  projects Project[]

  @@map("project_types")
}

model ProjectRole {
  id          Int              @id @default(autoincrement())
  name        String
  assignments TeamAssignment[]
  timesheetRules TimesheetApprovalRule[]

  @@map("project_roles")
}

// ==================== Auth & Session Tables ====================

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  password        String
  isActive        Boolean   @default(true) @map("is_active")
  rememberToken   String?   @map("remember_token")

  // New Employee Fields
  employeeId       String?   @unique @map("employee_id")
  joinDate         DateTime? @map("join_date")
  departmentId     Int?      @map("department_id")
  positionId       Int?      @map("position_id")
  employmentTypeId Int?      @map("employment_type_id")
  directManagerId  Int?      @map("direct_manager_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  department     Department?     @relation(fields: [departmentId], references: [id])
  position       Position?       @relation(fields: [positionId], references: [id])
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  directManager  User?           @relation("ManagerToEmployee", fields: [directManagerId], references: [id])
  subordinates   User[]          @relation("ManagerToEmployee")

  ownedProjects              Project[]
  teamAssignments            TeamAssignment[]
  assignedIncidents          Incident[]            @relation("IncidentAssignedTo")
  reportedIncidents          Incident[]            @relation("IncidentReportedBy")
  deployedDeployments        Deployment[]          @relation("DeploymentDeployedBy")
  infrastructureNodesCreated InfrastructureNode[]  @relation("InfrastructureNodeCreatedBy")
  requestedChanges           ChangeManagement[]    @relation("ChangeRequestedBy")
  approvedChanges            ChangeManagement[]    @relation("ChangeApprovedBy")
  implementedChanges         ChangeManagement[]    @relation("ChangeImplementedBy")
  assignedSecurityFindings   SecurityFinding[]     @relation("SecurityAssignedTo")
  reportedSecurityFindings   SecurityFinding[]     @relation("SecurityReportedBy")
  authoredDocuments          Document[]
  activities                 ActivityLog[]
  notifications              Notification[]
  helpdeskAssignedTickets    HelpdeskTicket[]      @relation("HelpdeskAssignedTo")
  helpdeskReportedTickets    HelpdeskTicket[]      @relation("HelpdeskReportedBy")
  helpdeskComments           HelpdeskComment[]
  helpdeskAttachments        HelpdeskAttachment[]
  taskComments               TaskComment[]
  taskActivities             TaskActivity[]
  // Timesheet & work log relations
  timeEntries                TimeEntry[]                   @relation("TimeEntryUser")
  microsoftAccount           MicrosoftAccount?
  timesheetToApprove         TimeEntry[]                   @relation("TimesheetApprover")
  subtasksAssigned           TaskSubtask[]                 @relation("SubtaskAssignee")
  timesheetRuleUsers         TimesheetApprovalRuleUser[]
  // Procurement relations
  createdRequisitions        RequisitionForm[]     @relation("RequisitionCreatedBy")
  approvalAssignments        ApprovalAssignment[]
  requisitionApprovals       RequisitionApproval[]
  purchaseOrdersCreated      PurchaseOrder[]       @relation("POCreatedBy")
  purchaseOrdersApproved     PurchaseOrder[]       @relation("POApprovedBy")
  directPurchases            DirectPurchase[]
  goodsReceiptsReceived      GoodsReceipt[]        @relation("GRNReceivedBy")
  paymentsApproved           Payment[]             @relation("PaymentApprovedBy")
  paymentsPaid               Payment[]             @relation("PaymentPaidBy")
  assetsAssigned             Asset[]               @relation("AssetAssignedTo")
  internalProjectsAssigned   InternalProject[]     @relation("InternalProjectAssignedTo")

  @@map("users")
}

model PasswordResetToken {
  email     String    @id
  token     String
  createdAt DateTime? @map("created_at")

  @@map("password_reset_tokens")
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  name      String
  password  String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_verifications")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Session {
  id           String  @id
  userId       Int?    @map("user_id")
  ipAddress    String? @map("ip_address") @db.VarChar(45)
  userAgent    String? @map("user_agent") @db.Text
  payload      String  @db.Text
  lastActivity Int     @map("last_activity")

  @@index([userId])
  @@index([lastActivity])
  @@map("sessions")
}

// ==================== Cache & Jobs Tables ====================

model Cache {
  key        String @id
  value      String @db.Text
  expiration Int

  @@map("cache")
}

model CacheLock {
  key        String @id
  owner      String
  expiration Int

  @@map("cache_locks")
}

model Job {
  id          Int    @id @default(autoincrement())
  queue       String
  payload     String @db.Text
  attempts    Int    @db.SmallInt
  reservedAt  Int?   @map("reserved_at")
  availableAt Int    @map("available_at")
  createdAt   Int    @map("created_at")

  @@index([queue])
  @@map("jobs")
}

model JobBatch {
  id           String  @id
  name         String
  totalJobs    Int     @map("total_jobs")
  pendingJobs  Int     @map("pending_jobs")
  failedJobs   Int     @map("failed_jobs")
  failedJobIds String  @map("failed_job_ids") @db.Text
  options      String? @db.Text
  cancelledAt  Int?    @map("cancelled_at")
  createdAt    Int     @map("created_at")
  finishedAt   Int?    @map("finished_at")

  @@map("job_batches")
}

model FailedJob {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.Text
  exception  String   @db.Text
  failedAt   DateTime @default(now()) @map("failed_at")

  @@map("failed_jobs")
}

// ==================== RBAC Tables ====================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  guardName   String   @map("guard_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions   RoleHasPermission[]
  modelHasRoles ModelHasRole[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  guardName   String   @map("guard_name")
  description String?
  group       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  modelHasPermissions ModelHasPermission[]
  roleHasPermissions  RoleHasPermission[]

  @@map("permissions")
}

model ModelHasPermission {
  permissionId Int    @map("permission_id")
  modelType    String @map("model_type")
  modelId      Int    @map("model_id")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([permissionId, modelType, modelId])
  @@index([modelId, modelType])
  @@map("model_has_permissions")
}

model ModelHasRole {
  roleId    Int    @map("role_id")
  modelType String @map("model_type")
  modelId   Int    @map("model_id")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, modelType, modelId])
  @@index([modelId, modelType])
  @@map("model_has_roles")
}

model RoleHasPermission {
  permissionId Int @map("permission_id")
  roleId       Int @map("role_id")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([permissionId, roleId])
  @@map("role_has_permissions")
}

// ==================== Activity Log ====================

model ActivityLog {
  id          Int      @id @default(autoincrement())
  logName     String?  @map("log_name")
  description String   @db.Text
  subjectType String?  @map("subject_type")
  subjectId   Int?     @map("subject_id")
  event       String?
  causerId    Int?     @map("causer_id")
  causerType  String?  @map("causer_type")
  properties  Json?
  batchUuid   String?  @map("batch_uuid") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [causerId], references: [id], onDelete: SetNull)

  @@index([logName])
  @@index([subjectType, subjectId])
  @@map("activity_log")
}

// ==================== Domain Tables ====================

model Project {
  id               Int     @id @default(autoincrement())
  name             String
  slug             String  @unique
  description      String? @db.Text
  status           String  @default("active")
  priority         String  @default("medium")
  ownerId          Int     @map("owner_id")
  repositoryUrl    String? @map("repository_url")
  documentationUrl String? @map("documentation_url")

  // New Fields
  projectTypeId   Int?      @map("project_type_id")
  startDate       DateTime? @map("start_date")
  expectedEndDate DateTime? @map("expected_end_date")
  actualEndDate   DateTime? @map("actual_end_date")
  healthStatus    String    @default("On Track") @map("health_status")
  delayReason     String?   @map("delay_reason") @db.Text
  recommendation  String?   @db.Text

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  owner                 User                   @relation(fields: [ownerId], references: [id])
  projectType           ProjectType?           @relation(fields: [projectTypeId], references: [id])
  environments          Environment[]
  teamAssignments       TeamAssignment[]
  infrastructureNodes   InfrastructureNode[]
  services              Service[]
  applications          Application[]
  domains               Domain[]
  sslCertificates       SslCertificate[]
  deployments           Deployment[]
  incidents             Incident[]
  changeManagements     ChangeManagement[]
  backupJobs            BackupJob[]
  disasterRecoveryPlans DisasterRecoveryPlan[]
  securityFindings      SecurityFinding[]
  documents             Document[]
  credentials           Credential[]
  budgetItems           BudgetItem[]
  requisitionForms      RequisitionForm[]
  helpdeskTickets       HelpdeskTicket[]
  tasks                 ProjectTask[] // Kanban tasks
  taskColumns           TaskColumn[] // Kanban columns
  timeEntries           TimeEntry[] // Work log entries
  // Procurement relations
  purchaseOrders        PurchaseOrder[]
  directPurchases       DirectPurchase[]
  assets                Asset[]
  internalProjects      InternalProject[]

  @@index([status])
  @@index([isActive])
  @@map("projects")
}

model Environment {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  name        String
  slug        String
  type        String
  description String?   @db.Text
  url         String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  infrastructureNodes InfrastructureNode[]
  services            Service[]
  applications        Application[]
  deployments         Deployment[]
  incidents           Incident[]
  changeManagements   ChangeManagement[]
  backupJobs          BackupJob[]

  @@unique([projectId, slug])
  @@index([type])
  @@index([isActive])
  @@map("environments")
}

model TeamAssignment {
  id            Int       @id @default(autoincrement())
  projectId     Int       @map("project_id")
  userId        Int       @map("user_id")
  projectRoleId Int       @map("project_role_id")
  assignedAt    DateTime? @map("assigned_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectRole ProjectRole @relation(fields: [projectRoleId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([projectRoleId])
  @@index([isActive])
  @@map("team_assignments")
}

// ==================== Kanban & Tasks ====================

model TaskColumn {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  name      String
  position  Int      @default(0) // order on the board
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@map("task_columns")
}

model ProjectTask {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  columnId    Int       @map("column_id")
  title       String
  description String?   @db.Text
  assignees   Json? // Storing as JSON array of user IDs
  priority    String    @default("medium") // low, medium, high, urgent
  position    Int       @default(0) // order within column
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column     TaskColumn     @relation(fields: [columnId], references: [id], onDelete: Cascade)
  comments   TaskComment[]
  activities TaskActivity[]
  subtasks   TaskSubtask[]
  timeEntries TimeEntry[]

  @@map("project_tasks")
}

model TaskComment {
  id           Int      @id @default(autoincrement())
  taskId       Int      @map("task_id")
  userId       Int      @map("user_id")
  content      String   @db.Text
  workingHours Decimal? @map("working_hours") @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

model TaskActivity {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  userId    Int      @map("user_id")
  action    String // created, moved, commented, assigned, unassigned, updated, deleted
  details   Json? // extra context like { from: "To Do", to: "In Progress", assignee: "John" }
  createdAt DateTime @default(now()) @map("created_at")

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_activities")
}

// ==================== Subtasks (2-level: task -> subtask) ====================

model TaskSubtask {
  id          Int       @id @default(autoincrement())
  taskId      Int       @map("task_id")
  title       String
  description String?   @db.Text
  assigneeId  Int?      @map("assignee_id")
  dueDate     DateTime? @map("due_date")
  status      String    @default("open") // open | in_progress | done
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  task        ProjectTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@index([taskId])
  @@index([assigneeId])
  @@index([status])
  @@map("task_subtasks")
}

// ==================== Timesheet & Shared Work Log ====================

model TimeEntry {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id") // who performed the work
  workDate       DateTime  @db.Date // calendar day of work (no TZ math)
  hours          Decimal   @db.Decimal(5, 2) // 0.25-24, step 0.25
  description    String    @db.Text

  // Linkage: ad-hoc (both null) | task | task+subtask
  taskId         Int?      @map("task_id") // parent ProjectTask
  subtaskId      Int?      @map("subtask_id")
  projectId      Int?      @map("project_id") // denormalized from task for routing/reports

  categoryValue  String    @map("category_value") // ReferenceData group timesheet_category
  status         String    @default("draft") // draft | submitted | approved | rejected
  submittedAt    DateTime? @map("submitted_at")
  decidedAt      DateTime? @map("decided_at")
  approverId     Int?      @map("approver_id") // resolved at submit; snapshot
  approvalRuleId Int?      @map("approval_rule_id")
  rejectReason   String?   @map("reject_reason") @db.Text

  // Actual work period (optional; e.g. meeting start/end imported from MS Teams)
  startTime      DateTime? @map("start_time")
  endTime        DateTime? @map("end_time")

  // Microsoft Teams calendar integration
  msEventId      String?   @map("ms_event_id") // source Graph event when entry was created from a meeting

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user         User                    @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  task         ProjectTask?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  subtask      TaskSubtask?            @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  project      Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approver     User?                   @relation("TimesheetApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approvalRule TimesheetApprovalRule?  @relation(fields: [approvalRuleId], references: [id], onDelete: SetNull)
  calendarEvent CalendarEvent?         @relation("CalendarEventTimeEntry")

  @@index([userId, workDate])
  @@index([taskId])
  @@index([subtaskId])
  @@index([projectId])
  @@index([status])
  @@index([approverId, status])
  @@index([msEventId])
  @@map("time_entries")
}

// ==================== Microsoft Teams / Entra ID Integration ====================

// Per-user Microsoft account link (OAuth tokens + sync preferences)
model MicrosoftAccount {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique @map("user_id")
  msUserId       String    @map("ms_user_id") // Entra ID object id (oid claim)
  email          String // Microsoft account email (mail / UPN)
  displayName    String?   @map("display_name")
  accessToken    String    @map("access_token") // AES-256-CBC encrypted
  refreshToken   String?   @map("refresh_token") // AES-256-CBC encrypted
  tokenExpiresAt DateTime  @map("token_expires_at")
  // Calendar sync: meetings auto-appear in My Work Portal calendar
  calendarSyncEnabled Boolean @default(true) @map("calendar_sync_enabled")
  // Timesheet sync mode: manual = log attendance on click; auto = draft entry per meeting
  timesheetAutoSync   Boolean @default(false) @map("timesheet_auto_sync")
  // Minimum meeting duration (minutes) eligible for auto timesheet entries
  minMeetingMinutes   Int     @default(15) @map("min_meeting_minutes")
  // Default category used for meeting-derived time entries
  timesheetCategory   String  @default("meeting") @map("timesheet_category")
  lastSyncedAt   DateTime? @map("last_synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarEvents CalendarEvent[]

  @@index([userId])
  @@map("microsoft_accounts")
}

// Cached Microsoft calendar event (meeting) per user
model CalendarEvent {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  msEventId       String    @map("ms_event_id") // Graph event id
  subject         String
  startAt         DateTime  @map("start_at") @db.Timestamptz(3)
  endAt           DateTime  @map("end_at") @db.Timestamptz(3)
  isOnlineMeeting Boolean   @default(false) @map("is_online_meeting")
  joinUrl         String?   @map("join_url")
  organizer       String?
  // Timesheet linkage
  attended        Boolean   @default(false)
  timeEntryId     Int?      @unique @map("time_entry_id")
  syncSource      String    @default("manual") // manual | auto
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  account    MicrosoftAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)
  timeEntry  TimeEntry?       @relation("CalendarEventTimeEntry", fields: [timeEntryId], references: [id], onDelete: SetNull)

  @@unique([userId, msEventId])
  @@index([userId, startAt])
  @@map("calendar_events")
}

// ==================== Timesheet Approval Rules ====================

model TimesheetApprovalRule {
  id            Int       @id @default(autoincrement())
  name          String
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0) // first match wins

  // Matchers (null = wildcard)
  categoryValue String?   @map("category_value") // timesheet_category value
  projectId     Int?      @map("project_id")

  // Approver resolver
  approverType  String    @map("approver_type") // project_role | users | direct_manager | app_role
  projectRoleId Int?      @map("project_role_id")
  appRole       String?   @map("app_role")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  projectRole   ProjectRole? @relation(fields: [projectRoleId], references: [id], onDelete: SetNull)
  users         TimesheetApprovalRuleUser[]
  timeEntries   TimeEntry[]

  @@index([isActive, sortOrder])
  @@map("timesheet_approval_rules")
}

model TimesheetApprovalRuleUser {
  ruleId Int
  userId Int

  rule TimesheetApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ruleId, userId])
  @@map("timesheet_approval_rule_users")
}

model InfrastructureNode {
  id                 Int       @id @default(autoincrement())
  projectId          Int       @map("project_id")
  environmentId      Int?      @map("environment_id")
  name               String
  hostname           String?
  ipAddress          String?   @map("ip_address")
  type               String
  status             String    @default("unknown")
  operatingSystem    String?   @map("operating_system")
  cpuCores           Int?      @map("cpu_cores")
  memoryGb           Int?      @map("memory_gb")
  storageGb          Int?      @map("storage_gb")
  provider           String?
  providerRegion     String?   @map("provider_region")
  providerInstanceId String?   @map("provider_instance_id")
  username           String?
  password           String?
  isActive           Boolean   @default(true) @map("is_active")
  metadata           Json?
  createdBy          Int?      @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  // Relations
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  createdByUser User?        @relation("InfrastructureNodeCreatedBy", fields: [createdBy], references: [id])
  services      Service[]

  @@index([type])
  @@index([status])
  @@index([isActive])
  @@map("infrastructure_nodes")
}

model Service {
  id                   Int       @id @default(autoincrement())
  projectId            Int       @map("project_id")
  environmentId        Int?      @map("environment_id")
  infrastructureNodeId Int?      @map("infrastructure_node_id")
  name                 String
  slug                 String
  type                 String
  status               String    @default("unknown")
  version              String?
  port                 Int?
  healthCheckUrl       String?   @map("health_check_url")
  description          String?   @db.Text
  isActive             Boolean   @default(true) @map("is_active")
  metadata             Json?
