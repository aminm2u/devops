  @@index([group])
  @@index([isActive])
  @@map("reference_data")
}

model ReferenceNumberConfig {
  id             Int      @id @default(autoincrement())
  refType        String   @unique @map("ref_type")
  prefix         String
  separator      String   @default("-")
  yearFormat     String   @default("YYYY") @map("year_format")
  digitPadding   Int      @default(4) @map("digit_padding")
  currentCounter Int      @default(1) @map("current_counter")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("reference_number_configs")
}

// ==================== Vendor Management ====================

model Vendor {
  id             Int       @id @default(autoincrement())
  name           String
  registrationNo String?   @map("registration_no")
  contactPerson  String?   @map("contact_person")
  email          String?
  phone          String?
  address        String?   @db.Text
  bankName       String?   @map("bank_name")
  bankAccountNo  String?   @map("bank_account_no")
  taxId          String?   @map("tax_id")
  category       String?
  rating         Int?
  isActive       Boolean   @default(true) @map("is_active")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  quotations      Quotation[]
  purchaseOrders  PurchaseOrder[]
  directPurchases DirectPurchase[]
  goodsReceipts   GoodsReceipt[]
  Payment         Payment[]
  InternalProject InternalProject[]

  @@index([name])
  @@index([isActive])
  @@map("vendors")
}

// ==================== Approval Policy ====================

model ApprovalPolicy {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  budgetType  String?   @map("budget_type")
  division    String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tiers       ApprovalPolicyTier[]
  assignments ApprovalAssignment[]

  @@index([budgetType])
  @@index([division])
  @@map("approval_policies")
}

model ApprovalPolicyTier {
  id                Int      @id @default(autoincrement())
  policyId          Int      @map("policy_id")
  minAmount         Decimal  @map("min_amount") @db.Decimal(12, 2)
  maxAmount         Decimal  @map("max_amount") @db.Decimal(12, 2)
  requiredApprovals Int      @default(1) @map("required_approvals")
  createdAt         DateTime @default(now()) @map("created_at")

  policy ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("approval_policy_tiers")
}

model ApprovalAssignment {
  id        Int      @default(autoincrement())
  policyId  Int      @map("policy_id")
  userId    Int      @map("user_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  policy ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([policyId, userId])
  @@map("approval_assignments")
}

model RequisitionApproval {
  id            Int       @id @default(autoincrement())
  requisitionId Int       @map("requisition_id")
  approverId    Int       @map("approver_id")
  status        String    @default("pending")
  order         Int       @default(0)
  comments      String?
  respondedAt   DateTime? @map("responded_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  requisition RequisitionForm @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  approver    User            @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([requisitionId, approverId])
  @@index([requisitionId])
  @@index([approverId])
  @@map("requisition_approvals")
}

// ==================== RFQ & Quotations ====================

model RequestForQuotation {
  id                 Int       @id @default(autoincrement())
  requisitionId      Int?      @map("requisition_id")
  rfqNumber          String    @unique @map("rfq_number")
  title              String
  description        String?   @db.Text
  type               String    @default("material")
  status             String    @default("draft")
  issueDate          DateTime? @map("issue_date")
  closingDate        DateTime? @map("closing_date")
  evaluationCriteria Json?     @map("evaluation_criteria")
  isActive           Boolean   @default(true) @map("is_active")
  metadata           Json?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  requisition RequisitionForm? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  items       RfqItem[]
  quotations  Quotation[]

  @@index([status])
  @@index([requisitionId])
  @@map("request_for_quotations")
}

model RfqItem {
  id            Int      @id @default(autoincrement())
  rfqId         Int      @map("rfq_id")
  description   String
  specification String?  @db.Text
  qty           Int      @default(1)
  uom           String?
  createdAt     DateTime @default(now()) @map("created_at")

  rfq      RequestForQuotation @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true) @map("is_active")

  @@index([rfqId])
  @@map("rfq_items")
}

model Quotation {
  id           Int       @id @default(autoincrement())
  rfqId        Int       @map("rfq_id")
  vendorId     Int       @map("vendor_id")
  quotedAmount Decimal   @map("quoted_amount") @db.Decimal(12, 2)
  currency     String    @default("MYR")
  validityDays Int?      @map("validity_days")
  deliveryDays Int?      @map("delivery_days")
  paymentTerms String?   @map("payment_terms")
  remarks      String?
  status       String    @default("submitted")
  isAwarded    Boolean   @default(false) @map("is_awarded")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  isActive     Boolean   @default(true) @map("is_active")

  rfq              RequestForQuotation @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor           Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items            QuotationItem[]
  purchaseOrder    PurchaseOrder?
  directPurchase   DirectPurchase?     @relation(fields: [directPurchaseId], references: [id])
  directPurchaseId Int?

  @@index([rfqId])
  @@index([vendorId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id          Int      @id @default(autoincrement())
  quotationId Int      @map("quotation_id")
  description String
  qty         Int      @default(1)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  uom         String?
  totalAmount Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// ==================== Purchase Orders ====================

model PurchaseOrder {
  id                   Int       @id @default(autoincrement())
  poNumber             String    @unique @map("po_number")
  type                 String    @default("po")
  requisitionId        Int?      @map("requisition_id")
  quotationId          Int?      @unique @map("quotation_id")
  vendorId             Int       @map("vendor_id")
  projectId            Int?      @map("project_id")
  budgetItemId         Int?      @map("budget_item_id")
  totalAmount          Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  taxAmount            Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  grandTotal           Decimal   @default(0) @map("grand_total") @db.Decimal(12, 2)
  currency             String    @default("MYR")
  status               String    @default("draft")
  priority             String    @default("normal")
  deliveryAddress      String?   @map("delivery_address") @db.Text
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  paymentTerms         String?   @map("payment_terms")
  notes                String?   @db.Text
  requestedById        Int?      @map("requested_by_id")
  approvedById         Int?      @map("approved_by_id")
  approvedAt           DateTime? @map("approved_at")
  isActive             Boolean   @default(true) @map("is_active")
  metadata             Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  requisition   RequisitionForm?    @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  quotation     Quotation?          @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  budgetItem    BudgetItem?         @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  createdBy     User?               @relation("POCreatedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy    User?               @relation("POApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items            PurchaseOrderItem[]
  goodsReceipts    GoodsReceipt[]
  payments         Payment[]
  Asset            Asset[]
  internalProjects InternalProject[]   @relation("InternalProjectPO")

  @@index([poNumber])
  @@index([status])
  @@index([vendorId])
  @@index([requisitionId])
  @@index([projectId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          Int      @id @default(autoincrement())
  poId        Int      @map("po_id")
  description String
  qty         Int      @default(1)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  uom         String?
  totalAmount Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  receivedQty Int      @default(0) @map("received_qty")
  createdAt   DateTime @default(now()) @map("created_at")

  purchaseOrder    PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  GoodsReceiptItem GoodsReceiptItem[]
  assets           Asset[]            @relation("AssetPoItem")

  isActive Boolean @default(true) @map("is_active")

  @@index([poId])
  @@map("purchase_order_items")
}

// ==================== Direct Purchase ====================

model DirectPurchase {
  id              Int       @id @default(autoincrement())
  referenceNumber String    @unique @map("reference_number")
  requisitionId   Int?      @map("requisition_id")
  vendorId        Int?      @map("vendor_id")
  projectId       Int?      @map("project_id")
  budgetItemId    Int?      @map("budget_item_id")
  description     String
  amount          Decimal   @db.Decimal(12, 2)
  taxAmount       Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  grandTotal      Decimal   @default(0) @map("grand_total") @db.Decimal(12, 2)
  currency        String    @default("MYR")
  invoiceNumber   String?   @map("invoice_number")
  status          String    @default("draft")
  requestedById   Int?      @map("requested_by_id")
  isActive        Boolean   @default(true) @map("is_active")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  requisition RequisitionForm? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  vendor      Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  budgetItem  BudgetItem?      @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  requestedBy User?            @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  payments    Payment[]
  Quotation   Quotation[]

  @@index([status])
  @@index([vendorId])
  @@index([projectId])
  @@map("direct_purchases")
}

// ==================== Goods Receipt & Assets ====================

model GoodsReceipt {
  id              Int      @id @default(autoincrement())
  grnNumber       String   @unique @map("grn_number")
  purchaseOrderId Int      @map("po_id")
  vendorId        Int      @map("vendor_id")
  receivedDate    DateTime @default(now()) @map("received_date")
  receivedById    Int      @map("received_by_id")
  status          String   @default("pending")
  deliveryNote    String?  @map("delivery_note") @db.Text
  inspectionNotes String?  @map("inspection_notes") @db.Text
  inspectedBy     String?  @map("inspected_by")
  inspectedAt     DateTime? @map("inspected_at")
  deletedAt       DateTime? @map("deleted_at")
  isActive        Boolean  @default(true) @map("is_active")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  vendor        Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  receivedBy    User               @relation("GRNReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]
  assets        Asset[]

  @@index([purchaseOrderId])
  @@index([status])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id          Int      @id @default(autoincrement())
  grnId       Int      @map("grn_id")
  poItemId    Int      @map("po_item_id")
  description     String
  orderedQty      Int      @map("ordered_qty")
  receivedQty     Int      @map("received_qty")
  acceptedQty     Int      @default(0) @map("accepted_qty")
  rejectedQty     Int      @default(0) @map("rejected_qty")
  rejectionReason String?  @map("rejection_reason")
  uom             String?
  condition       String?
  createdAt   DateTime @default(now()) @map("created_at")

  goodsReceipt      GoodsReceipt      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Cascade)
  assets            Asset[]           @relation("AssetGrItem")

  isActive Boolean @default(true) @map("is_active")

  @@index([grnId])
  @@map("goods_receipt_items")
}

model Asset {
  id             Int       @id @default(autoincrement())
  assetNumber    String    @unique @map("asset_number")
  name           String
  description    String?
  category       String?
  serialNumber   String?   @map("serial_number")
  poId                Int?      @map("po_id")
  grnId               Int?      @map("grn_id")
  poItemId            Int?      @map("po_item_id")
  goodsReceiptItemId  Int?      @map("goods_receipt_item_id")
  projectId      Int?      @map("project_id")
  departmentId   Int?      @map("department_id")
  location       String?
  status         String    @default("active")
  purchasePrice  Decimal   @map("purchase_price") @db.Decimal(12, 2)
  purchaseDate   DateTime? @map("purchase_date")
  warrantyExpiry DateTime? @map("warranty_expiry")
  isActive       Boolean   @default(true) @map("is_active")
  currentValue   Decimal   @default(0) @map("current_value") @db.Decimal(12, 2)
  lastTransferredAt DateTime? @map("last_transferred_at")
  assignedToId   Int?      @map("assigned_to_id")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  purchaseOrder    PurchaseOrder?     @relation(fields: [poId], references: [id], onDelete: SetNull)
  goodsReceipt     GoodsReceipt?      @relation(fields: [grnId], references: [id], onDelete: SetNull)
  poItem           PurchaseOrderItem? @relation("AssetPoItem", fields: [poItemId], references: [id], onDelete: SetNull)
  goodsReceiptItem GoodsReceiptItem?  @relation("AssetGrItem", fields: [goodsReceiptItemId], references: [id], onDelete: SetNull)
  assignedTo       User?              @relation("AssetAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([assetNumber])
  @@index([status])
  @@index([category])
  @@map("assets")
}

// ==================== Payments ====================

model Payment {
  id               Int       @id @default(autoincrement())
  referenceNumber  String    @unique @map("reference_number")
  purchaseOrderId  Int?      @map("purchase_order_id")
  directPurchaseId Int?      @map("direct_purchase_id")
  vendorId         Int       @map("vendor_id")
  amount           Decimal   @db.Decimal(12, 2)
  taxAmount        Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalPaid        Decimal   @default(0) @map("total_paid") @db.Decimal(12, 2)
  currency         String    @default("MYR")
  paymentMethod    String?   @map("payment_method")
  invoiceNumber    String?   @map("invoice_number")
  invoiceDate      DateTime? @map("invoice_date")
  paymentDate      DateTime? @map("payment_date")
  dueDate          DateTime? @map("due_date")
  status           String    @default("draft")
  invoiceUrl       String?   @map("invoice_url")
  paidAt           DateTime? @map("paid_at")
  paidById         Int?      @map("paid_by_id")
  approvedById     Int?      @map("approved_by_id")
  approvedAt       DateTime? @map("approved_at")
  notes            String?   @db.Text
  isActive         Boolean   @default(true) @map("is_active")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  purchaseOrder  PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  directPurchase DirectPurchase?     @relation(fields: [directPurchaseId], references: [id], onDelete: SetNull)
  vendor         Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  approvedBy     User?               @relation("PaymentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  paidBy         User?               @relation("PaymentPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  attachments    PaymentAttachment[]

  @@index([purchaseOrderId])
  @@index([directPurchaseId])
  @@index([vendorId])
  @@index([status])
  @@map("payments")
}

model PaymentAttachment {
  id           Int      @id @default(autoincrement())
  paymentId    Int      @map("payment_id")
  filename     String
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  path         String
  uploadedBy   Int?     @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  payment  Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true) @map("is_active")

  @@index([paymentId])
  @@map("payment_attachments")
}

// ==================== Internal Projects (Services) ====================

model InternalProject {
  id              Int       @id @default(autoincrement())
  name            String
  slug            String    @unique
  description     String?   @db.Text
  scopeOfWork     String?   @map("scope_of_work") @db.Text
  currency        String    @default("MYR")
  progress        Int       @default(0)
  requisitionId   Int?      @map("requisition_id")
  purchaseOrderId Int?      @map("purchase_order_id")
  projectId       Int?      @map("project_id")
  vendorId        Int?      @map("vendor_id")
  budgetItemId    Int?      @map("budget_item_id")
  type            String    @default("internal")
  status          String    @default("planning")
  totalValue      Decimal   @default(0) @map("total_value") @db.Decimal(12, 2)
  startDate       DateTime? @map("start_date")
  expectedEndDate DateTime? @map("expected_end_date")
  actualEndDate   DateTime? @map("actual_end_date")
  assignedToId    Int?      @map("assigned_to_id")
  isActive        Boolean   @default(true) @map("is_active")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  requisition   RequisitionForm?  @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?    @relation("InternalProjectPO", fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  vendor        Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  budgetItem    BudgetItem?       @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  assignedTo    User?             @relation("InternalProjectAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([projectId])
  @@map("internal_projects")
}
