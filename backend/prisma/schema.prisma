generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== REFERENCE TABLES ====================

model Department {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  managerId Int?     @map("manager_id")
  employees User[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("departments")
}

model Position {
  id         Int    @id @default(autoincrement())
  name       String
  gradeLevel Int?   @map("grade_level")
  employees  User[]

  @@map("positions")
}

model EmploymentType {
  id        Int    @id @default(autoincrement())
  name      String
  employees User[]

  @@map("employment_types")
}

model ProjectType {
  id       Int       @id @default(autoincrement())
  name     String
  projects Project[]

  @@map("project_types")
}

model ProjectRole {
  id          Int              @id @default(autoincrement())
  name        String
  assignments TeamAssignment[]

  @@map("project_roles")
}

// ==================== Auth & Session Tables ====================

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  password        String
  isActive        Boolean   @default(true) @map("is_active")
  rememberToken   String?   @map("remember_token")

  // New Employee Fields
  employeeId       String?   @unique @map("employee_id")
  joinDate         DateTime? @map("join_date")
  departmentId     Int?      @map("department_id")
  positionId       Int?      @map("position_id")
  employmentTypeId Int?      @map("employment_type_id")
  directManagerId  Int?      @map("direct_manager_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  department     Department?     @relation(fields: [departmentId], references: [id])
  position       Position?       @relation(fields: [positionId], references: [id])
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  directManager  User?           @relation("ManagerToEmployee", fields: [directManagerId], references: [id])
  subordinates   User[]          @relation("ManagerToEmployee")

  ownedProjects              Project[]
  teamAssignments            TeamAssignment[]
  assignedIncidents          Incident[]           @relation("IncidentAssignedTo")
  reportedIncidents          Incident[]           @relation("IncidentReportedBy")
  deployedDeployments        Deployment[]         @relation("DeploymentDeployedBy")
  infrastructureNodesCreated InfrastructureNode[] @relation("InfrastructureNodeCreatedBy")
  requestedChanges           ChangeManagement[]   @relation("ChangeRequestedBy")
  approvedChanges            ChangeManagement[]   @relation("ChangeApprovedBy")
  implementedChanges         ChangeManagement[]   @relation("ChangeImplementedBy")
  assignedSecurityFindings   SecurityFinding[]    @relation("SecurityAssignedTo")
  reportedSecurityFindings   SecurityFinding[]    @relation("SecurityReportedBy")
  authoredDocuments          Document[]
  activities                 ActivityLog[]
  notifications              Notification[]
  helpdeskAssignedTickets    HelpdeskTicket[]     @relation("HelpdeskAssignedTo")
  helpdeskReportedTickets    HelpdeskTicket[]     @relation("HelpdeskReportedBy")
  helpdeskComments           HelpdeskComment[]
  helpdeskAttachments        HelpdeskAttachment[]
  taskComments               TaskComment[]
  taskActivities             TaskActivity[]

  @@map("users")
}

model PasswordResetToken {
  email     String    @id
  token     String
  createdAt DateTime? @map("created_at")

  @@map("password_reset_tokens")
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  name      String
  password  String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_verifications")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Session {
  id           String  @id
  userId       Int?    @map("user_id")
  ipAddress    String? @map("ip_address") @db.VarChar(45)
  userAgent    String? @map("user_agent") @db.Text
  payload      String  @db.Text
  lastActivity Int     @map("last_activity")

  @@index([userId])
  @@index([lastActivity])
  @@map("sessions")
}

// ==================== Cache & Jobs Tables ====================

model Cache {
  key        String @id
  value      String @db.Text
  expiration Int

  @@map("cache")
}

model CacheLock {
  key        String @id
  owner      String
  expiration Int

  @@map("cache_locks")
}

model Job {
  id          Int    @id @default(autoincrement())
  queue       String
  payload     String @db.Text
  attempts    Int    @db.SmallInt
  reservedAt  Int?   @map("reserved_at")
  availableAt Int    @map("available_at")
  createdAt   Int    @map("created_at")

  @@index([queue])
  @@map("jobs")
}

model JobBatch {
  id           String  @id
  name         String
  totalJobs    Int     @map("total_jobs")
  pendingJobs  Int     @map("pending_jobs")
  failedJobs   Int     @map("failed_jobs")
  failedJobIds String  @map("failed_job_ids") @db.Text
  options      String? @db.Text
  cancelledAt  Int?    @map("cancelled_at")
  createdAt    Int     @map("created_at")
  finishedAt   Int?    @map("finished_at")

  @@map("job_batches")
}

model FailedJob {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.Text
  exception  String   @db.Text
  failedAt   DateTime @default(now()) @map("failed_at")

  @@map("failed_jobs")
}

// ==================== RBAC Tables ====================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  guardName   String   @map("guard_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions   RoleHasPermission[]
  modelHasRoles ModelHasRole[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  guardName   String   @map("guard_name")
  description String?
  group       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  modelHasPermissions ModelHasPermission[]
  roleHasPermissions  RoleHasPermission[]

  @@map("permissions")
}

model ModelHasPermission {
  permissionId Int    @map("permission_id")
  modelType    String @map("model_type")
  modelId      Int    @map("model_id")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([permissionId, modelType, modelId])
  @@index([modelId, modelType])
  @@map("model_has_permissions")
}

model ModelHasRole {
  roleId    Int    @map("role_id")
  modelType String @map("model_type")
  modelId   Int    @map("model_id")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, modelType, modelId])
  @@index([modelId, modelType])
  @@map("model_has_roles")
}

model RoleHasPermission {
  permissionId Int @map("permission_id")
  roleId       Int @map("role_id")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([permissionId, roleId])
  @@map("role_has_permissions")
}

// ==================== Activity Log ====================

model ActivityLog {
  id          Int      @id @default(autoincrement())
  logName     String?  @map("log_name")
  description String   @db.Text
  subjectType String?  @map("subject_type")
  subjectId   Int?     @map("subject_id")
  event       String?
  causerId    Int?     @map("causer_id")
  causerType  String?  @map("causer_type")
  properties  Json?
  batchUuid   String?  @map("batch_uuid") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [causerId], references: [id], onDelete: SetNull)

  @@index([logName])
  @@index([subjectType, subjectId])
  @@map("activity_log")
}

// ==================== Domain Tables ====================

model Project {
  id               Int     @id @default(autoincrement())
  name             String
  slug             String  @unique
  description      String? @db.Text
  status           String  @default("active")
  priority         String  @default("medium")
  ownerId          Int     @map("owner_id")
  repositoryUrl    String? @map("repository_url")
  documentationUrl String? @map("documentation_url")

  // New Fields
  projectTypeId   Int?      @map("project_type_id")
  startDate       DateTime? @map("start_date")
  expectedEndDate DateTime? @map("expected_end_date")
  actualEndDate   DateTime? @map("actual_end_date")
  healthStatus    String    @default("On Track") @map("health_status")
  delayReason     String?   @map("delay_reason") @db.Text
  recommendation  String?   @db.Text

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  owner                 User                   @relation(fields: [ownerId], references: [id])
  projectType           ProjectType?           @relation(fields: [projectTypeId], references: [id])
  environments          Environment[]
  teamAssignments       TeamAssignment[]
  infrastructureNodes   InfrastructureNode[]
  services              Service[]
  applications          Application[]
  domains               Domain[]
  sslCertificates       SslCertificate[]
  deployments           Deployment[]
  incidents             Incident[]
  changeManagements     ChangeManagement[]
  backupJobs            BackupJob[]
  disasterRecoveryPlans DisasterRecoveryPlan[]
  securityFindings      SecurityFinding[]
  documents             Document[]
  credentials           Credential[]
  budgetItems           BudgetItem[]
  requisitionForms      RequisitionForm[]
  helpdeskTickets       HelpdeskTicket[]
  tasks                 ProjectTask[] // Kanban tasks
  taskColumns           TaskColumn[] // Kanban columns

  @@index([status])
  @@index([isActive])
  @@map("projects")
}

model Environment {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  name        String
  slug        String
  type        String
  description String?   @db.Text
  url         String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  infrastructureNodes InfrastructureNode[]
  services            Service[]
  applications        Application[]
  deployments         Deployment[]
  incidents           Incident[]
  changeManagements   ChangeManagement[]
  backupJobs          BackupJob[]

  @@unique([projectId, slug])
  @@index([type])
  @@index([isActive])
  @@map("environments")
}

model TeamAssignment {
  id            Int       @id @default(autoincrement())
  projectId     Int       @map("project_id")
  userId        Int       @map("user_id")
  projectRoleId Int       @map("project_role_id")
  assignedAt    DateTime? @map("assigned_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectRole ProjectRole @relation(fields: [projectRoleId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([projectRoleId])
  @@index([isActive])
  @@map("team_assignments")
}

// ==================== Kanban & Tasks ====================

model TaskColumn {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  name      String
  position  Int      @default(0) // order on the board
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@map("task_columns")
}

model ProjectTask {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  columnId    Int       @map("column_id")
  title       String
  description String?   @db.Text
  assignees   Json?     // Storing as JSON array of user IDs
  priority    String    @default("medium") // low, medium, high, urgent
  position    Int       @default(0) // order within column
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column    TaskColumn     @relation(fields: [columnId], references: [id], onDelete: Cascade)
  comments  TaskComment[]
  activities TaskActivity[]

  @@map("project_tasks")
}

model TaskComment {
  id            Int      @id @default(autoincrement())
  taskId        Int      @map("task_id")
  userId        Int      @map("user_id")
  content       String   @db.Text
  workingHours  Decimal? @db.Decimal(5, 2) @map("working_hours")
  createdAt     DateTime @default(now()) @map("created_at")

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

model TaskActivity {
  id        Int      @id @default(autoincrement())
  taskId     Int      @map("task_id")
  userId     Int      @map("user_id")
  action     String   // created, moved, commented, assigned, unassigned, updated, deleted
  details    Json?    // extra context like { from: "To Do", to: "In Progress", assignee: "John" }
  createdAt  DateTime @default(now()) @map("created_at")

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_activities")
}

model InfrastructureNode {
  id                 Int       @id @default(autoincrement())
  projectId          Int       @map("project_id")
  environmentId      Int?      @map("environment_id")
  name               String
  hostname           String?
  ipAddress          String?   @map("ip_address")
  type               String
  status             String    @default("unknown")
  operatingSystem    String?   @map("operating_system")
  cpuCores           Int?      @map("cpu_cores")
  memoryGb           Int?      @map("memory_gb")
  storageGb          Int?      @map("storage_gb")
  provider           String?
  providerRegion     String?   @map("provider_region")
  providerInstanceId String?   @map("provider_instance_id")
  username           String?
  password           String?
  isActive           Boolean   @default(true) @map("is_active")
  metadata           Json?
  createdBy          Int?      @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  // Relations
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  createdByUser User?        @relation("InfrastructureNodeCreatedBy", fields: [createdBy], references: [id])
  services      Service[]

  @@index([type])
  @@index([status])
  @@index([isActive])
  @@map("infrastructure_nodes")
}

model Service {
  id                   Int       @id @default(autoincrement())
  projectId            Int       @map("project_id")
  environmentId        Int?      @map("environment_id")
  infrastructureNodeId Int?      @map("infrastructure_node_id")
  name                 String
  slug                 String
  type                 String
  status               String    @default("unknown")
  version              String?
  port                 Int?
  healthCheckUrl       String?   @map("health_check_url")
  description          String?   @db.Text
  isActive             Boolean   @default(true) @map("is_active")
  metadata             Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  // Relations
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment        Environment?        @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  infrastructureNode InfrastructureNode? @relation(fields: [infrastructureNodeId], references: [id], onDelete: SetNull)
  domains            Domain[]

  @@unique([projectId, slug])
  @@index([type])
  @@index([status])
  @@index([isActive])
  @@map("services")
}

model Application {
  id             Int       @id @default(autoincrement())
  projectId      Int       @map("project_id")
  environmentId  Int?      @map("environment_id")
  name           String
  slug           String
  type           String
  status         String    @default("unknown")
  version        String?
  repositoryUrl  String?   @map("repository_url")
  deploymentUrl  String?   @map("deployment_url")
  healthCheckUrl String?   @map("health_check_url")
  description    String?   @db.Text
  isActive       Boolean   @default(true) @map("is_active")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment      Environment?      @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  domains          Domain[]
  deployments      Deployment[]
  securityFindings SecurityFinding[]

  @@unique([projectId, slug])
  @@index([type])
  @@index([status])
  @@index([isActive])
  @@map("applications")
}

model Domain {
  id             Int       @id @default(autoincrement())
  projectId      Int?      @map("project_id")
  serviceId      Int?      @map("service_id")
  applicationId  Int?      @map("application_id")
  name           String
  type           String    @default("primary")
  status         String    @default("active")
  registrar      String?
  expirationDate DateTime? @map("expiration_date")
  autoRenew      Boolean   @default(false) @map("auto_renew")
  nameservers    Json?
  isActive       Boolean   @default(true) @map("is_active")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  service         Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  application     Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  sslCertificates SslCertificate[]

  @@unique([projectId, name])
  @@index([type])
  @@index([status])
  @@index([expirationDate])
  @@index([isActive])
  @@map("domains")
}

model SslCertificate {
  id              Int       @id @default(autoincrement())
  domainId        Int?      @map("domain_id")
  projectId       Int       @map("project_id")
  name            String
  type            String    @default("letsencrypt")
  status          String    @default("pending")
  issuer          String?
  subject         String?
  serialNumber    String?   @map("serial_number")
  fingerprint     String?
  notBefore       DateTime? @map("not_before")
  notAfter        DateTime? @map("not_after")
  autoRenew       Boolean   @default(true) @map("auto_renew")
  certificatePath String?   @map("certificate_path")
  privateKeyPath  String?   @map("private_key_path")
  isActive        Boolean   @default(true) @map("is_active")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  domain  Domain? @relation(fields: [domainId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([notAfter])
  @@index([isActive])
  @@map("ssl_certificates")
}

model Deployment {
  id              Int       @id @default(autoincrement())
  projectId       Int       @map("project_id")
  environmentId   Int?      @map("environment_id")
  applicationId   Int?      @map("application_id")
  name            String
  status          String    @default("pending")
  version         String?
  branch          String?
  commitHash      String?   @map("commit_hash")
  commitMessage   String?   @map("commit_message") @db.Text
  deployedBy      Int?      @map("deployed_by")
  deployedAt      DateTime? @map("deployed_at")
  completedAt     DateTime? @map("completed_at")
  durationSeconds Int?      @map("duration_seconds")
  isRollback      Boolean   @default(false) @map("is_rollback")
  rollbackFromId  Int?      @map("rollback_from_id")
  notes           String?   @db.Text
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment    Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  deployedByUser User?        @relation("DeploymentDeployedBy", fields: [deployedBy], references: [id], onDelete: SetNull)
  rollbackFrom   Deployment?  @relation("DeploymentRollback", fields: [rollbackFromId], references: [id], onDelete: SetNull)
  rollbacks      Deployment[] @relation("DeploymentRollback")

  @@index([status])
  @@index([deployedAt])
  @@map("deployments")
}

model Incident {
  id            Int       @id @default(autoincrement())
  projectId     Int       @map("project_id")
  environmentId Int?      @map("environment_id")
  title         String
  slug          String
  description   String?   @db.Text
  status        String    @default("open")
  severity      String    @default("medium")
  priority      String    @default("medium")
  assignedTo    Int?      @map("assigned_to")
  reportedBy    Int?      @map("reported_by")
  startedAt     DateTime? @map("started_at")
  resolvedAt    DateTime? @map("resolved_at")
  rootCause     String?   @map("root_cause") @db.Text
  resolution    String?   @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment  Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  assignedUser User?        @relation("IncidentAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  reportedUser User?        @relation("IncidentReportedBy", fields: [reportedBy], references: [id], onDelete: SetNull)

  @@unique([projectId, slug])
  @@index([status])
  @@index([severity])
  @@index([priority])
  @@index([isActive])
  @@map("incidents")
}

model ChangeManagement {
  id            Int       @id @default(autoincrement())
  projectId     Int       @map("project_id")
  environmentId Int?      @map("environment_id")
  title         String
  slug          String
  description   String?   @db.Text
  type          String    @default("standard")
  status        String    @default("draft")
  riskLevel     String    @default("medium") @map("risk_level")
  priority      String    @default("medium")
  requestedBy   Int?      @map("requested_by")
  approvedBy    Int?      @map("approved_by")
  implementedBy Int?      @map("implemented_by")
  requestedAt   DateTime? @map("requested_at")
  approvedAt    DateTime? @map("approved_at")
  implementedAt DateTime? @map("implemented_at")
  rollbackPlan  String?   @map("rollback_plan") @db.Text
  notes         String?   @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment     Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  requestedUser   User?        @relation("ChangeRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)
  approvedUser    User?        @relation("ChangeApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  implementedUser User?        @relation("ChangeImplementedBy", fields: [implementedBy], references: [id], onDelete: SetNull)

  @@unique([projectId, slug])
  @@index([status])
  @@index([type])
  @@index([riskLevel])
  @@index([priority])
  @@index([isActive])
  @@map("change_managements")
}

model BackupJob {
  id                  Int       @id @default(autoincrement())
  projectId           Int       @map("project_id")
  environmentId       Int?      @map("environment_id")
  name                String
  slug                String
  type                String
  status              String    @default("pending")
  schedule            String?
  retentionDays       Int       @default(30) @map("retention_days")
  storageLocation     String?   @map("storage_location")
  storagePath         String?   @map("storage_path")
  lastRunAt           DateTime? @map("last_run_at")
  nextRunAt           DateTime? @map("next_run_at")
  lastSuccessAt       DateTime? @map("last_success_at")
  lastFailureAt       DateTime? @map("last_failure_at")
  lastBackupSizeBytes BigInt?   @map("last_backup_size_bytes")
  isActive            Boolean   @default(true) @map("is_active")
  metadata            Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  // Relations
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@unique([projectId, slug])
  @@index([status])
  @@index([isActive])
  @@map("backup_jobs")
}

model DisasterRecoveryPlan {
  id           Int       @id @default(autoincrement())
  projectId    Int       @map("project_id")
  name         String
  slug         String
  description  String?   @db.Text
  type         String    @default("standard")
  status       String    @default("draft")
  priority     String    @default("medium")
  rpoHours     Int?      @map("rpo_hours")
  rtoHours     Int?      @map("rto_hours")
  lastTestedAt DateTime? @map("last_tested_at")
  nextTestAt   DateTime? @map("next_test_at")
  testResults  Json?     @map("test_results")
  procedures   Json?
  contacts     Json?
  isActive     Boolean   @default(true) @map("is_active")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([status])
  @@index([priority])
  @@index([isActive])
  @@map("disaster_recovery_plans")
}

model SecurityFinding {
  id                Int       @id @default(autoincrement())
  projectId         Int       @map("project_id")
  applicationId     Int?      @map("application_id")
  title             String
  slug              String
  description       String?   @db.Text
  status            String    @default("open")
  severity          String    @default("medium")
  priority          String    @default("medium")
  type              String    @default("vulnerability")
  source            String?
  cveId             String?   @map("cve_id")
  cvssScore         Float?    @map("cvss_score")
  affectedComponent String?   @map("affected_component")
  remediation       String?   @db.Text
  assignedTo        Int?      @map("assigned_to")
  reportedBy        Int?      @map("reported_by")
  foundAt           DateTime? @map("found_at")
  resolvedAt        DateTime? @map("resolved_at")
  isActive          Boolean   @default(true) @map("is_active")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // Relations
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  application  Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  assignedUser User?        @relation("SecurityAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  reportedUser User?        @relation("SecurityReportedBy", fields: [reportedBy], references: [id], onDelete: SetNull)

  @@unique([projectId, slug])
  @@index([status])
  @@index([severity])
  @@index([priority])
  @@index([cveId])
  @@index([isActive])
  @@map("security_findings")
}

model Document {
  id        Int       @id @default(autoincrement())
  projectId Int       @map("project_id")
  title     String
  slug      String
  content   String?   @db.Text
  type      String    @default("other")
  status    String    @default("draft")
  authorId  Int?      @map("author_id")
  version   String    @default("1.0")
  isActive  Boolean   @default(true) @map("is_active")
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([projectId, slug])
  @@index([type])
  @@index([status])
  @@index([isActive])
  @@map("documents")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  group     String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@index([group])
  @@map("settings")
}

// ==================== Budget Control ====================

model BudgetItem {
  id              Int       @id @default(autoincrement())
  projectId       Int?      @map("project_id")
  division        String    @default("Information Technology")
  category        String
  description     String
  details         String?
  requestor       String
  allocatedBudget Decimal   @map("allocated_budget") @db.Decimal(12, 2)
  utilizedBudget  Decimal   @default(0) @map("utilized_budget") @db.Decimal(12, 2)
  poNumber        String?   @map("po_number")
  currency        String    @default("MYR")
  status          String    @default("active")
  fiscalYear      String?   @map("fiscal_year")
  isActive        Boolean   @default(true) @map("is_active")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  expenditures BudgetExpenditure[]
  requisitions RequisitionForm[]

  @@index([category])
  @@index([division])
  @@index([status])
  @@index([isActive])
  @@map("budget_items")
}

model BudgetExpenditure {
  id              Int       @id @default(autoincrement())
  budgetItemId    Int       @map("budget_item_id")
  amount          Decimal   @db.Decimal(12, 2)
  description     String
  vendor          String?
  invoiceNumber   String?   @map("invoice_number")
  poNumber        String?   @map("po_number")
  expenditureDate DateTime? @map("expenditure_date")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  budgetItem BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)

  @@index([budgetItemId])
  @@map("budget_expenditures")
}

model Credential {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  name        String
  type        String   @default("server")
  host        String
  port        Int?
  username    String?
  password    String?
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
  @@map("credentials")
}

model RequisitionForm {
  id                 Int       @id @default(autoincrement())
  projectId          Int?      @map("project_id")
  division           String
  processOwner       String?   @map("process_owner")
  budgetItemId       Int?      @map("budget_item_id")
  totalEstimatedCost Decimal   @default(0) @map("total_estimated_cost") @db.Decimal(12, 2)
  requiredDate       DateTime? @map("required_date")
  purpose            String?   @db.Text
  status             String    @default("draft")
  requestedByName    String?   @map("requested_by_name")
  requestedByDate    DateTime? @map("requested_by_date")
  approvedByName     String?   @map("approved_by_name")
  approvedByDate     DateTime? @map("approved_by_date")
  isActive           Boolean   @default(true) @map("is_active")
  metadata           Json?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  items      RequisitionItem[]
  budgetItem BudgetItem?       @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  project    Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([projectId])
  @@index([division])
  @@index([budgetItemId])
  @@index([isActive])
  @@map("requisition_forms")
}

model RequisitionItem {
  id                Int       @id @default(autoincrement())
  requisitionFormId Int       @map("requisition_form_id")
  description       String
  qty               Int       @default(1)
  unitPrice         Decimal   @default(0) @map("unit_price") @db.Decimal(12, 2)
  uom               String?   @map("uom")
  remark            String?
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  requisitionForm RequisitionForm @relation(fields: [requisitionFormId], references: [id], onDelete: Cascade)

  @@index([requisitionFormId])
  @@map("requisition_items")
}

// ==================== Helpdesk Module ====================

model HelpdeskCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String?
  color       String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tickets HelpdeskTicket[]

  @@index([isActive])
  @@map("helpdesk_categories")
}

model HelpdeskTicket {
  id              Int       @id @default(autoincrement())
  projectId       Int?      @map("project_id")
  title           String
  slug            String
  description     String?   @db.Text
  status          String    @default("open") @map("status")
  priority        String    @default("medium")
  categoryId      Int?      @map("category_id")
  source          String    @default("web")
  assignedTo      Int?      @map("assigned_to")
  reportedBy      Int?      @map("reported_by")
  contactName     String?   @map("contact_name")
  contactEmail    String?   @map("contact_email")
  contactPhone    String?   @map("contact_phone")
  slaResponseAt   DateTime? @map("sla_response_at")
  slaResolutionAt DateTime? @map("sla_resolution_at")
  resolvedAt      DateTime? @map("resolved_at")
  closedAt        DateTime? @map("closed_at")
  satisfaction    Int?
  resolutionNotes String?   @map("resolution_notes") @db.Text
  isActive        Boolean   @default(true) @map("is_active")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  project     Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category    HelpdeskCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignee    User?                @relation("HelpdeskAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  reporter    User?                @relation("HelpdeskReportedBy", fields: [reportedBy], references: [id], onDelete: SetNull)
  comments    HelpdeskComment[]
  attachments HelpdeskAttachment[]

  @@unique([projectId, slug])
  @@index([status])
  @@index([priority])
  @@index([categoryId])
  @@index([assignedTo])
  @@index([reportedBy])
  @@index([isActive])
  @@map("helpdesk_tickets")
}

model HelpdeskComment {
  id         Int       @id @default(autoincrement())
  ticketId   Int       @map("ticket_id")
  userId     Int?      @map("user_id")
  content    String    @db.Text
  isInternal Boolean   @default(false) @map("is_internal")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  ticket HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([userId])
  @@map("helpdesk_comments")
}

model HelpdeskAttachment {
  id           Int      @id @default(autoincrement())
  ticketId     Int      @map("ticket_id")
  commentId    Int?     @map("comment_id")
  filename     String
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  path         String
  uploadedBy   Int?     @map("uploaded_by")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket   HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploader User?          @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("helpdesk_attachments")
}
